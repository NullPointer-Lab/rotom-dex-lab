[Unit]
Description=Rotom Dex agent HTTP shim (bridges the Rotom Dex Lab UI to the Hermes rotom-dex agent)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/rotom-agent.env
ExecStart=/usr/bin/python3 %h/rotom-agent/rotom_agent_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
